{
  "name": "@sirai/domain",
  "private": true,
  "version": "0.0.0",
  "description": "Conceptos y reglas de negocio de SIRAI (catálogos, inscripciones, consentimiento, asistencia). TypeScript puro, sin dependencias de framework.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@sirai/eslint-config": "workspace:*",
    "@sirai/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
