{
  "name": "@sirai/config",
  "private": true,
  "version": "0.0.0",
  "description": "Esquemas de configuración por entorno. Sin secretos: solo validación y valores por defecto.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sirai/eslint-config": "workspace:*",
    "@sirai/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
