{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "NODE_ENV",
        "VITE_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "SESSION_TTL_HOURS",
        "LOGIN_MAX_ATTEMPTS",
        "LOGIN_LOCK_MINUTES",
        "COOKIE_SECURE",
        "WEB_ORIGIN",
        "SEED_PASSWORD",
        "VITE_API_URL",
        "DATA_ENCRYPTION_KEY",
        "LOGIN_RATE_LIMIT_PER_MINUTE",
        "TEST_DATABASE_URL",
        "SESSION_MAX_HOURS",
        "TRUST_PROXY"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "env": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "SESSION_TTL_HOURS",
        "LOGIN_MAX_ATTEMPTS",
        "LOGIN_LOCK_MINUTES",
        "COOKIE_SECURE",
        "WEB_ORIGIN",
        "SEED_PASSWORD",
        "TEST_DATABASE_URL",
        "DATA_ENCRYPTION_KEY",
        "LOGIN_RATE_LIMIT_PER_MINUTE",
        "SESSION_MAX_HOURS",
        "TRUST_PROXY"
      ]
    }
  }
}
