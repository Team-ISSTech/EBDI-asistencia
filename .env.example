# Copia este archivo a .env y ajusta los valores. Nunca subas .env a Git.
# Todos los valores de este archivo son de desarrollo; no son secretos reales.

# ---- Pila Docker (docker compose) ----
# Puertos publicados en localhost. Cambia MYSQL_PORT si 3306 ya está ocupado
# (revisa con: lsof -nP -iTCP:3306 -sTCP:LISTEN).
WEB_PORT=8080
MYSQL_PORT=3306
# Imágenes preconstruidas (GHCR). Con `docker compose up --build` se construyen localmente.
IMAGE_REGISTRY=ghcr.io/team-isstech
IMAGE_TAG=main
# ADVERTENCIA: con SEED_DEV_DATA=true se crean 7 cuentas <rol>@sirai.test con
# la contraseña de SEED_PASSWORD. Úsalo SOLO en tu máquina; si copias este
# archivo a un servidor compartido pon false. Nunca corre con NODE_ENV=production.
SEED_DEV_DATA=true
SEED_PASSWORD=cambia-esta-contrasena

# ---- API ----
NODE_ENV=development
PORT=3000
# Cadena de conexión a MySQL 8 para `pnpm dev` (coincide con docker-compose.yml).
DATABASE_URL=mysql://sirai:sirai@127.0.0.1:3306/sirai
# Base separada para pruebas de integración; se vacía en cada corrida.
TEST_DATABASE_URL=mysql://sirai:sirai@127.0.0.1:3306/sirai_test
# Horas de inactividad antes de expirar una sesión y tope absoluto de vida.
SESSION_TTL_HOURS=12
SESSION_MAX_HOURS=72
# Intentos fallidos antes de bloquear una cuenta y minutos de bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Días que dura una contraseña temporal antes de caducar (RF-38).
TEMP_PASSWORD_DAYS=7
# Intentos de inicio de sesión por IP y minuto antes de responder 429.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Llave AES-256 para columnas cifradas y diffs de auditoría: 32 bytes en hex.
# Esta es SOLO de desarrollo. Para cualquier otro entorno genera la tuya con:
#   openssl rand -hex 32
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# true en producción (cookies solo por HTTPS); la API lo exige con NODE_ENV=production.
COOKIE_SECURE=false
# Versión vigente del aviso de privacidad (la confirma el área jurídica). El servidor
# la guarda en cada consentimiento; en producción es obligatoria. Vacía en desarrollo
# se registra como SIN-VERSION-DESARROLLO.
PRIVACY_NOTICE_VERSION=
# Llave de firma de los tokens de sistemas externos (RF-37). Fuera de producción, si
# falta, se deriva de DATA_ENCRYPTION_KEY; en producción es obligatoria y distinta de ella.
#   openssl rand -hex 32
API_TOKEN_SECRET=
# Minutos de vida de un token de sistema y peticiones por minuto de cada sistema.
INTEGRATION_TOKEN_MINUTES=15
INTEGRATION_RATE_LIMIT_PER_MINUTE=60
# Avisos por WhatsApp a los contactos de emergencia (RF-27). Sin cuenta no se envía nada:
# los avisos quedan pendientes en la base hasta que se configure. Ver docs/operations/avisos-whatsapp.md.
# El token es un secreto del cliente: ponlo solo en tu .env o en el gestor de secretos, nunca en Git.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=aviso_urgente_sirai
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
# Segundos entre corridas del proceso que envía los avisos pendientes (0 lo apaga).
EMERGENCY_NOTICE_JOB_SECONDS=60
# Segundos entre corridas del proceso que abre los tickets de ausencia (0 lo apaga).
FOLLOW_UP_JOB_SECONDS=60
# true solo detrás de un proxy inverso que fije X-Forwarded-For (la pila Docker lo fuerza).
TRUST_PROXY=false
# Origen permitido para la web durante `pnpm dev`.
WEB_ORIGIN=http://localhost:5173

# ---- Web (pnpm dev) ----
VITE_API_URL=http://localhost:3000
