# Copia este archivo a .env y ajusta los valores. Nunca subas .env a Git.
# Todos los valores de este archivo son de desarrollo; no son secretos reales.

# API
NODE_ENV=development
PORT=3000
# Cadena de conexión a MySQL 8 (coincide con docker-compose.yml).
DATABASE_URL=mysql://sirai:sirai@localhost:3306/sirai
# Horas de inactividad antes de expirar una sesión.
SESSION_TTL_HOURS=12
# Intentos fallidos antes de bloquear una cuenta y minutos de bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# true en producción (cookies solo por HTTPS).
COOKIE_SECURE=false
# Origen permitido para la web durante desarrollo.
WEB_ORIGIN=http://localhost:5173

# Semilla de desarrollo: contraseña inicial de los usuarios ficticios.
SEED_PASSWORD=cambia-esta-contrasena

# Web
VITE_API_URL=http://localhost:3000
